# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# =============================================================================
# 1. REQUIRED — the AI that answers questions (free)
# =============================================================================
# Get a free key at https://aistudio.google.com/apikey
# No credit card required.
GEMINI_API_KEY=

# =============================================================================
# 2a. OPTIONAL — live Google Docs sync, EASY WAY (no Google Cloud needed)
# =============================================================================
# แก้ Google Doc แล้วบอทรู้ทันที ภายใน 5 นาที
#
# วิธีทำ:
#   1. เปิด Google Doc ที่ต้องการ
#   2. แชร์ → "ทุกคนที่มีลิงก์" → ผู้อ่าน
#   3. คัดลอก URL มาวางข้างล่าง คั่นด้วยจุลภาคถ้ามีหลายไฟล์
#
# ข้อแลกเปลี่ยน: เอกสารต้องเปิดให้คนที่มีลิงก์อ่านได้
# (สำหรับข้อมูลรับสมัครที่เป็นข้อมูลสาธารณะอยู่แล้ว ปกติไม่มีปัญหา)
GOOGLE_DOC_URLS=

# =============================================================================
# 2b. OPTIONAL — live Google Drive sync, ทั้งโฟลเดอร์ (ต้องตั้งค่า Google Cloud)
# =============================================================================
# ใช้เมื่อต้องการให้บอทเห็นทุกไฟล์ในโฟลเดอร์อัตโนมัติ รวมไฟล์ที่เพิ่มใหม่
# และไม่ต้องเปิดเอกสารเป็นสาธารณะ
#
# ถ้าตั้งค่าทั้ง 2a และ 2b ระบบจะใช้ 2b
# Lets staff correct the bot by editing a Google Doc, with no redeploy.
# Without these the bot still works, using only the bundled admission guides.
#
# Setup is in README.md ("เชื่อม Google Drive"). In short:
#   Google Cloud → create a service account → download the JSON key →
#   share the Drive folder with the service account's email (Viewer).

# The service account's email, e.g. mfu-bot@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The "private_key" field from the downloaded JSON, in full, including the
# BEGIN/END lines. Keep it on ONE line with literal \n where the newlines were,
# and wrap it in double quotes.
GOOGLE_PRIVATE_KEY=""

# The folder ID from its URL:
# https://drive.google.com/drive/folders/THIS_PART_HERE
GOOGLE_DRIVE_FOLDER_ID=

# How long to reuse Drive content before re-reading it. Default 300 (5 minutes).
DRIVE_CACHE_TTL_SECONDS=300

# =============================================================================
# 3. OPTIONAL — LINE bot
# =============================================================================
# Both come from https://developers.line.biz/console/
#   Channel secret:       your channel > Basic settings
#   Channel access token: your channel > Messaging API > Channel access token
# The web page at / works without these.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# หน่วงเวลาก่อนตอบ (มิลลิวินาที) ให้ดูเป็นธรรมชาติขึ้น
# ค่าเริ่มต้น 12000 = 12 วินาที | ใส่ 0 เพื่อตอบทันที
# เพดาน 30000 — เพราะ reply token ของ LINE มีอายุแค่ 1 นาที
LINE_REPLY_DELAY_MS=12000

# หน่วงระหว่างแต่ละ bubble (ค่าเริ่มต้น 3000 = 3 วินาที)
LINE_BUBBLE_DELAY_MS=3000

# =============================================================================
# 4. OPTIONAL — conversation memory (Upstash Redis free tier)
# =============================================================================
# Install Upstash Redis from the Vercel Marketplace and connect it to this
# project. Vercel injects these first two values automatically. Without them,
# the bot continues to work but cannot remember language/context between LINE
# messages such as a follow-up that only says "OK".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Some Vercel Redis integrations inject these names instead. The bot supports
# both naming schemes; do not duplicate them if Vercel already created these.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A long random value used only to hash LINE user IDs before they become Redis
# keys. If omitted, LINE_CHANNEL_SECRET is used. Setting a separate value is
# recommended for easier secret rotation.
CONVERSATION_HASH_SECRET=
