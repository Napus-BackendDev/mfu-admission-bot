  "study_plan_definitions": {
    "master": {
      "A1": "Thesis (not less than 36 credits), no course work",
      "A2": "Thesis (24 credits) with course work (12 credits)",
      "B": "Course work (30 credits) with Independent Study (IS) (6 credits)",
      "1.1": "Thesis",
      "1.2": "Thesis with course work",
      "2": "Course work with Independent Study (IS) or Special Project",
      "note": "Credit requirements may vary depending on the programme."
    },
    "doctoral": {
      "1.1": "Dissertation only (not less than 48 credits) - for master's degree graduates",
      "1.2": "Dissertation only (not less than 72 credits) - for bachelor's degree with honours graduates",
      "2.1": "Course work (not less than 12 credits) with dissertation (not less than 36 credits) - for master's degree graduates",
      "2.2": "Course work (not less than 24 credits) with dissertation (not less than 48 credits) - for bachelor's degree with honours graduates"
    }
  },

  "campus_note": "Students attending class in Bangkok are required to attend class at MFU Hospital, Bangkok. All other programmes are taught at the Chiang Rai campus."
}
